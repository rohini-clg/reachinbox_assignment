// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  hourlyLimit Int    @default(200)
  delayBetweenEmailsMs Int @default(2000)
  emails    Email[]
  slackIntegration SlackIntegration?
  createdAt DateTime @default(now())
}

model SlackIntegration {
  id                    String   @id @default(uuid())
  senderId              String   @unique
  sender                Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String
  encryptedWebhookUrl   String
  channelName           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Email {
  id          String      @id @default(uuid())
  idempotencyKey String?  @unique
  requestHash String?
  to          String
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(PENDING)
  sender      Sender      @relation(fields: [senderId], references: [id])
  senderId    String
  createdAt   DateTime    @default(now())

  @@index([senderId, status, scheduledAt])
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
