# Copy this file to .env, then replace the PostgreSQL password and all other placeholders.
# .env is loaded from the backend directory even when commands are started from the repository root.
# Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/email_scheduler?schema=public"
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set REDIS_URL instead of REDIS_HOST/REDIS_PORT when using a managed service.

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_API_TOKEN=replace-with-a-long-random-secret

# SMTP Configuration (Get free test account at https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-username
SMTP_PASS=your-ethereal-password

# Rate Limiting Configuration
MAX_EMAILS_PER_HOUR=200
DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# Optional search integration. Required to enable Elasticsearch search.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Optional Slack OAuth. Configure the OAuth redirect URL to /api/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_TOKEN_ENCRYPTION_KEY=
